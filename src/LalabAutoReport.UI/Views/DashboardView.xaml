<UserControl x:Class="LalabAutoReport.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LalabAutoReport.UI.ViewModels"
             xmlns:converters="clr-namespace:LalabAutoReport.UI.Converters"
             mc:Ignorable="d" 
             Focusable="True"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Tinix.Color.Bg.Body}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar / Date Navigation -->
            <RowDefinition Height="Auto"/> <!-- Summary Strip -->
            <RowDefinition Height="Auto"/> <!-- Filter & Search -->
            <RowDefinition Height="*"/>    <!-- Orders Content -->
            <RowDefinition Height="Auto"/> <!-- Footer / Status -->
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date controls Pod & Date Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- DATE POD CARD (Tinix Orange Pastel Focus Pod) -->
                    <Border Background="{StaticResource Tinix.Color.DatePod.Bg}" 
                            BorderBrush="{StaticResource Tinix.Color.DatePod.Border}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="10,4,10,4" 
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Orange Accent Indicator bar -->
                            <Border Width="3.5" Height="22" Background="{StaticResource Tinix.Color.Primary}" CornerRadius="1.5" Margin="0,0,10,0"/>

                            <!-- Icon & Title Label -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="📅" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="NGÀY LÀM VIỆC:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinix.Color.DatePod.Text}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Navigation buttons & DatePicker -->
                            <Button Command="{Binding PreviousDayCommand}" Content="◀" Width="28" Height="32" Style="{StaticResource Tinix.Button.Secondary}" Padding="0" Margin="0,0,4,0" ToolTip="Ngày trước"/>
                            <DatePicker SelectedDate="{Binding SelectedDate}" Height="32" Width="138" Margin="0,0,4,0" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="13"/>
                            <Button Command="{Binding NextDayCommand}" Content="▶" Width="28" Height="32" Style="{StaticResource Tinix.Button.Secondary}" Padding="0" Margin="0,0,6,0" ToolTip="Ngày sau"/>
                            <Button Command="{Binding TodayCommand}" Content="Hôm nay" Height="32" Style="{StaticResource Tinix.Button.Secondary}" Padding="10,0" ToolTip="Về ngày hôm nay" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Divider separating Date Pod and Date Actions -->
                    <Border Width="1" Height="24" Background="{StaticResource Tinix.Color.Border.Subtle}" Margin="12,0"/>

                    <!-- Action buttons for selected date -->
                    <Button Command="{Binding ScanDateCommand}" Content="🔄 Quét lại" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Padding="12,0" Margin="0,0,6,0" ToolTip="Quét lại ngày đang chọn" FontSize="12.5" FontWeight="SemiBold"/>
                    <Button Command="{Binding OpenDateFolderCommand}" Content="📂 Thư mục" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Padding="10,0" ToolTip="Mở thư mục ngày" FontSize="12.5"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ScanMissingDaysCommand}" Content="Quét ngày còn thiếu" Height="36" Style="{StaticResource Tinix.Button.Secondary}" Padding="14,0"/>
                    <Button Command="{Binding CancelScanCommand}" Content="Hủy Quét" Height="36" Style="{StaticResource Tinix.Button.Danger}" Margin="8,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUMMARY STRIP -->
        <Border Grid.Row="1" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <!-- Total Orders Badge Card (Purple) -->
                <Border Background="{StaticResource Tinix.Color.Card.Order.Bg}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Card.Order.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tổng số đơn: " Foreground="{StaticResource Tinix.Color.Card.Order.Title}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding TotalOrders}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Order.Value}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Total Customers Badge Card (Emerald) -->
                <Border Background="{StaticResource Tinix.Color.Card.Customer.Bg}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Card.Customer.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Khách hàng: " Foreground="{StaticResource Tinix.Color.Card.Customer.Title}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding TotalCustomers}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Card.Customer.Value}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Needs Review Badge Card -->
                <Border Background="{StaticResource Tinix.Color.Warning.Bg}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Warning.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cần xử lý: " Foreground="{StaticResource Tinix.Color.Warning}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding NeedsReviewCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Warning}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Ready Badge Card -->
                <Border Background="{StaticResource Tinix.Color.Success.Bg}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Success.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sẵn sàng: " Foreground="{StaticResource Tinix.Color.Success}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding ReadyCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Billed Badge Card -->
                <Border Background="{StaticResource Tinix.Color.Info.Bg}" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="16,8" Margin="0,0,12,0" BorderBrush="{StaticResource Tinix.Color.Info.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Đã tính Bill: " Foreground="{StaticResource Tinix.Color.Info}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding BilledCount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Info}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- FILTER & SEARCH -->
        <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Pill-like Filter Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Tất cả" IsChecked="{Binding CurrentFilter, ConverterParameter=All, Mode=OneWay}" Click="FilterAll_Click" Style="{StaticResource Tinix.FilterPill}"/>
                    <RadioButton Content="👤 Khách quen" IsChecked="{Binding CurrentFilter, ConverterParameter=Regular, Mode=OneWay}" Click="FilterRegular_Click" Style="{StaticResource Tinix.FilterPill}"/>
                    <RadioButton Content="⚡ Khách lẻ" IsChecked="{Binding CurrentFilter, ConverterParameter=Guest, Mode=OneWay}" Click="FilterGuest_Click" Style="{StaticResource Tinix.FilterPill}"/>
                    <RadioButton Content="Cần xử lý (!)" IsChecked="{Binding CurrentFilter, ConverterParameter=NeedsReview, Mode=OneWay}" Click="FilterNeedsReview_Click" Style="{StaticResource Tinix.FilterPill}"/>
                    <RadioButton Content="Sẵn sàng (✓)" IsChecked="{Binding CurrentFilter, ConverterParameter=Ready, Mode=OneWay}" Click="FilterReady_Click" Style="{StaticResource Tinix.FilterPill}"/>
                    <RadioButton Content="Đã tính Bill (🧾)" IsChecked="{Binding CurrentFilter, ConverterParameter=Billed, Mode=OneWay}" Click="FilterBilled_Click" Style="{StaticResource Tinix.FilterPill}"/>
                    <RadioButton Content="Chưa giao (📦)" IsChecked="{Binding CurrentFilter, ConverterParameter=Undelivered, Mode=OneWay}" Click="FilterUndelivered_Click" Style="{StaticResource Tinix.FilterPill}"/>
                    <RadioButton Content="Đã giao (🚚)" IsChecked="{Binding CurrentFilter, ConverterParameter=Delivered, Mode=OneWay}" Click="FilterDelivered_Click" Style="{StaticResource Tinix.FilterPill}"/>
                </StackPanel>

                <!-- Root Folder Filter Combobox -->
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding RootFolderFilterOptions}" 
                          SelectedValuePath="Id" 
                          DisplayMemberPath="Name" 
                          SelectedValue="{Binding SelectedRootFolderId}" 
                          Height="34" FontSize="12" VerticalContentAlignment="Center"
                          ToolTip="Lọc hiển thị theo Kho dữ liệu"/>

                <!-- Search Box -->
                <TextBox Grid.Column="4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" FontSize="12">
                    <TextBox.Resources>
                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍 Tìm kiếm khách, quy cách..." Foreground="{StaticResource Tinix.Color.Text.Muted}" Margin="8,0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource Tinix.TextBox.Standard}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- ORDERS CONTENT REGION (List or Empty State) -->
        <Grid Grid.Row="3">
            <!-- EMPTY STATE (Section 21.2) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40" MaxWidth="520">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOrders}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="36,30">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="Chưa Có Dữ Liệu Đơn Hàng" FontFamily="{StaticResource Tinix.Font.Display}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Chưa có đơn hàng nào được ghi nhận cho ngày làm việc này, hoặc không có kết quả phù hợp với bộ lọc/tìm kiếm hiện tại." Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding ScanDateCommand}" Content="🔍 Quét Ngày Này" Height="38" Style="{StaticResource Tinix.Button.Primary}" Padding="20,0" Margin="0,0,10,0"/>
                            <Button Command="{Binding OpenDateFolderCommand}" Content="Mở Thư Mục Ngày" Height="38" Style="{StaticResource Tinix.Button.Secondary}" Padding="16,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ORDERS LIST (VIRTUALIZED) -->
            <ListBox ItemsSource="{Binding FilteredOrders}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="20"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOrders}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="OrderCard_MouseDoubleClick"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OrderDisplayModel}">
                        <!-- Tinix Card Container -->
                        <Border Background="{StaticResource Tinix.Color.Bg.Surface}" CornerRadius="{StaticResource Tinix.Radius.Lg}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Margin="0,0,0,14" Padding="18">
                            <StackPanel>
                                <!-- Order Header (Trái: Thumbnail 56x56; Phải: Thông tin & Nút) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- THUMBNAIL BOX (56x56) -->
                                    <Border Grid.Column="0"
                                            Width="56" Height="56"
                                            CornerRadius="6"
                                            Background="#F8FAFC"
                                            BorderBrush="{StaticResource Tinix.Color.Border.Subtle}"
                                            BorderThickness="1"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp"
                                            ToolTip="{Binding ThumbnailTooltip}"
                                            Visibility="{Binding DataContext.ShowOrderThumbnails, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <!-- Placeholder / Icon khi chưa nạp hoặc không có ảnh -->
                                            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#F1F5F9"
                                                    Visibility="{Binding IsThumbnailPlaceholderVisible, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="🖼️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                            </Border>

                                            <!-- Thumbnail Image -->
                                            <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasThumbnailImage, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Badge cho định dạng nặng/đồ họa (PSD, RAW, TIF...) -->
                                            <Border Background="#1E293B" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding IsUnsupportedFormat, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ThumbnailFormatExtension}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" FontFamily="Consolas, monospace"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Order Header Info (2 Rows) -->
                                    <StackPanel Grid.Column="1">
                                        <!-- Hàng trên: Tên đơn hàng và Cụm nút thao tác -->
                                        <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Customer Folder Name -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📁 " FontSize="16" VerticalAlignment="Center"/>
                                            <!-- Order Code Badge: e.g. [DH-260929-001] -->
                                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Nhấn để sao chép mã đơn" MouseLeftButtonUp="OrderCodeBadge_MouseLeftButtonUp">
                                                <TextBlock Text="{Binding DisplayOrderCode}" FontWeight="SemiBold" FontSize="13" Foreground="#334155" FontFamily="Consolas, Segoe UI Mono, monospace"/>
                                            </Border>
                                            <TextBlock Text="{Binding FullOrderDisplayName}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullOrderDisplayName}"/>
                                        </StackPanel>

                                            <!-- Order Actions -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Mở thư mục" Height="30" Padding="12,0" Margin="0,0,6,0" Style="{StaticResource Tinix.Button.Secondary}" Click="OpenOrderFolder_Click"/>
                                                <Button Content="🖼️ Xem ảnh" Height="30" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource Tinix.Button.Secondary}" Click="OpenOrderGallery_Click" ToolTip="Mở thư viện xem toàn bộ ảnh in của đơn hàng"/>
                                                <Button Content="🗑 Xóa" Height="30" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource Tinix.Button.Secondary}" Click="DeleteOrder_Click"
                                                        ToolTip="{Binding DeleteOrderTooltip}"
                                                        IsEnabled="{Binding CanDelete}"/>

                                                <!-- Nút Ghi chú -->
                                                <Button Content="📝 Ghi chú" Height="30" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource Tinix.Button.Secondary}"
                                                        Command="{Binding DataContext.EditOrderNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Thêm hoặc sửa ghi chú cho đơn hàng này"/>

                                                <!-- Nút In tem nhiệt đóng gói (Bên trái nút Giao hàng theo yêu cầu) -->
                                                <Button Content="🏷️ In tem" Height="30" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource Tinix.Button.Secondary}"
                                                        Command="{Binding DataContext.PrintOrderLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Xem trước và in tem nhiệt đóng gói 75x100mm (tự động đánh dấu ĐÃ GIAO)"/>

                                                <!-- Nút trạng thái Giao hàng (Chưa giao / Đã giao) -->
                                                <Button Height="30" Padding="10,0" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ToggleDeliveredCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding DeliveredButtonTooltip}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Tinix.Button.Secondary}">
                                                            <Setter Property="Content" Value="🚚 Chưa giao"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDelivered}" Value="True">
                                                                    <Setter Property="Content" Value="🚚 Đã giao"/>
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Nút Xem Bill: Luôn hiển thị cho mọi đơn hàng -->
                                                <Button Content="🧾 Xem Bill" Height="30" Padding="14,0" Style="{StaticResource Tinix.Button.Info}" Click="ComputeOrViewBill_Click"
                                                        ToolTip="Mở xem chi tiết và chỉnh sửa hóa đơn (hoặc bấm đúp vào thẻ đơn)"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Hàng dưới: Tags nhận diện, số lượng (trái) và Thành tiền (phải) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Bên trái: Customer Mapping Badge, Status Badge, và Số lượng (Ảnh in, Album) -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Customer Mapping Badge (Clickable to change customer) -->
                                                <Button Command="{Binding DataContext.AssignCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding CustomerMappingTooltip}"
                                                        Margin="0,0,8,0" Padding="0" BorderThickness="0" Background="Transparent"
                                                        Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="BadgeBorder" CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2"
                                                                                Background="{Binding CustomerBadgeBg}"
                                                                                BorderBrush="{Binding CustomerBadgeBorder}"
                                                                                BorderThickness="1" SnapsToDevicePixels="True">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding CustomerBadgeText}"
                                                                                           Foreground="{Binding CustomerBadgeFg}"
                                                                                           FontSize="11" FontWeight="SemiBold"/>
                                                                                <TextBlock Text=" ▾" FontSize="9" FontWeight="Bold"
                                                                                           Foreground="{Binding CustomerBadgeFg}"
                                                                                           Opacity="0.7" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="BadgeBorder" Property="Opacity" Value="0.85"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Tinix Pill Status Badge -->
                                                <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="10,3" Margin="0,0,8,0" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Bill Export Status Badge (Đã xuất bill / Chưa xuất bill) -->
                                                <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Margin="0,0,8,0"
                                                        Background="{Binding BillExportStatusBadgeBg}"
                                                        BorderBrush="{Binding BillExportStatusBadgeBorder}"
                                                        BorderThickness="1" VerticalAlignment="Center"
                                                        ToolTip="{Binding BillExportStatusTooltip}">
                                                    <TextBlock Text="{Binding BillExportStatusBadgeText}" Foreground="{Binding BillExportStatusBadgeFg}" FontSize="11" FontWeight="Bold"/>
                                                </Border>

                                                <!-- Printed Status Badge (shown when marked as PRINTED or PARTIAL) -->
                                                <Border Visibility="{Binding HasPrintProgressBadge, Converter={StaticResource BoolToVis}}" CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Margin="0,0,8,0" Background="{Binding PrintedStatusBadgeBg}" BorderBrush="{Binding PrintedStatusBadgeBorder}" BorderThickness="1" VerticalAlignment="Center" ToolTip="Tiến độ in ấn trong xưởng">
                                                    <TextBlock Text="{Binding PrintedStatusText}" Foreground="{Binding PrintedStatusBadgeFg}" FontSize="11" FontWeight="Bold"/>
                                                </Border>

                                                <!-- Delivered Status Badge (shown when marked as DELIVERED) -->
                                                <Border Visibility="{Binding IsDelivered, Converter={StaticResource BoolToVis}}" CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Margin="0,0,8,0" Background="{Binding DeliveredStatusBadgeBg}" BorderBrush="{Binding DeliveredStatusBadgeBorder}" BorderThickness="1" VerticalAlignment="Center" ToolTip="{Binding DeliveredDetailText}">
                                                    <TextBlock Text="{Binding DeliveredStatusText}" Foreground="{Binding DeliveredStatusBadgeFg}" FontSize="11" FontWeight="Bold"/>
                                                </Border>

                                                <!-- Root Folder Badge (shown when order has RootFolderName) -->
                                                <Border Visibility="{Binding HasRootFolder, Converter={StaticResource BoolToVis}}" CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" Margin="0,0,14,0" Background="{StaticResource Tinix.Color.Bg.Subtle}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" VerticalAlignment="Center" ToolTip="Kho dữ liệu chứa đơn hàng này">
                                                    <TextBlock Text="{Binding RootBadgeText}" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Divider mờ giữa Badges và Số lượng -->
                                                <Border Width="1" Height="14" Background="{StaticResource Tinix.Color.Border.Subtle}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                                <!-- Summary Totals (Counts) -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Ảnh in: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TotalPhotos}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,14,0" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Album: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TotalAlbums}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Bên phải: Thành tiền (Căn thẳng dưới cụm nút bấm) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Thành tiền: " Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FormattedTotalAmount}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}" FontSize="15" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Order Note Banner (shown when HasNote is true) -->
                                <Border Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" 
                                        Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12,7" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📝 Ghi chú: " FontWeight="Bold" Foreground="#92400E" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Note}" Foreground="#78350F" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                        <Button Grid.Column="2" Content="Sửa ghi chú" Style="{StaticResource Tinix.Button.Secondary}" Padding="8,2" Height="24" FontSize="11"
                                                Command="{Binding DataContext.EditOrderNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>

                                <!-- Items / Specifications Table -->
                                <Border Background="{StaticResource Tinix.Color.Bg.Subtle}" CornerRadius="{StaticResource Tinix.Radius.Md}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" Padding="10">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OrderItemDisplayModel}">
                                                <Border BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1" Padding="8,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row info -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="200"/> <!-- Spec Name & Category -->
                                                                <ColumnDefinition Width="120"/> <!-- Số lượng / Số tờ -->
                                                                <ColumnDefinition Width="200"/> <!-- Đơn giá / Gói album -->
                                                                <ColumnDefinition Width="110"/> <!-- Thành tiền -->
                                                                <ColumnDefinition Width="*"/>   <!-- Trạng thái -->
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Col 0: Spec Name & Category Badge -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SpecName}" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SpecName}" MaxWidth="130"/>
                                                                <Border CornerRadius="4" Padding="5,2" Margin="6,0,0,0" Background="#E8EAED" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#3C4043" FontWeight="Medium"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Col 1: Quantity / Sheet count -->
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedQuantityText}" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" FontSize="12"/>

                                                            <!-- Col 2: Unit Price / Album Package -->
                                                            <TextBlock Grid.Column="2" Text="{Binding FormattedUnitPrice}" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Text.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FormattedUnitPrice}" Margin="0,0,8,0"/>

                                                            <!-- Col 3: Line Total -->
                                                            <TextBlock Grid.Column="3" Text="{Binding FormattedLineTotal}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Tinix.Color.Success}" FontSize="12"/>

                                                            <!-- Col 4: Print Status Toggle & Billing Status Badge -->
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Command="{Binding DataContext.ToggleItemPrintedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="{Binding ItemPrintedBadgeBg}"
                                                                        BorderBrush="{Binding ItemPrintedBadgeBorder}"
                                                                        BorderThickness="1"
                                                                        Padding="8,2"
                                                                        Margin="0,0,8,0"
                                                                        Height="24"
                                                                        Cursor="Hand"
                                                                        ToolTip="Bấm để chuyển đổi trạng thái Đã in / Chưa in cho thư mục quy cách này">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="{StaticResource Tinix.Radius.Full}"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <TextBlock Text="{Binding ItemPrintedBadgeText}" Foreground="{Binding ItemPrintedBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                                                </Button>

                                                                <Border CornerRadius="{StaticResource Tinix.Radius.Full}" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" ToolTip="{Binding EffectiveBillingFolderTooltip}">
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row resolution controls (shown when ambiguous) -->
                                                        <StackPanel Grid.Row="1" Margin="200,8,0,0">
                                                            <!-- AMBIGUOUS LEAF FOLDERS -->
                                                            <StackPanel Visibility="{Binding IsAmbiguous, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="⚠️ Có nhiều nhánh thư mục tính số lượng hợp lệ, vui lòng bấm chọn nhánh thực tế:" Foreground="{StaticResource Tinix.Color.Warning}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                                                <ItemsControl ItemsSource="{Binding CandidateFolders}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                                <Button Content="Chọn nhánh này" Style="{StaticResource Tinix.Button.Primary}" Padding="10,4" Margin="0,0,8,0" FontSize="11" Click="SelectCandidateFolder_Click"/>
                                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="{StaticResource Tinix.Color.Text.Primary}" FontFamily="Consolas" FontSize="12"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- FOOTER / STATUS BAR -->
        <Border Grid.Row="4" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ScanProgressText}" Foreground="{StaticResource Tinix.Color.Primary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <ProgressBar Value="{Binding ScanProgressPercent}" Width="140" Height="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LIGHTBOX PREVIEW POPUP (IN-APP MODAL OVERLAY) -->
        <Grid Grid.Row="0" Grid.RowSpan="5" 
              Visibility="{Binding IsPreviewPopupOpen, Converter={StaticResource BoolToVis}}" 
              Panel.ZIndex="1000">
            <!-- Dark semi-transparent backdrop (Click outside to close) -->
            <Border Background="#99000000" MouseLeftButtonDown="PreviewBackdrop_MouseLeftButtonDown"/>

            <!-- Centered Modal Card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Tinix.Color.Bg.Surface}"
                    BorderBrush="{StaticResource Tinix.Color.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Tinix.Radius.Lg}"
                    MaxWidth="420"
                    Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header: Title, Order info, Close button -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="🖼️ " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PreviewOrder.CanonicalCustomerName, FallbackValue='Ảnh Nhận Diện Đơn Hàng'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PreviewOrder.OrderCode, StringFormat='Mã đơn: {0}'}" FontSize="12" FontFamily="{StaticResource Tinix.Font.Mono}" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ClosePreviewPopupCommand}" Content="✕" Width="28" Height="28" Style="{StaticResource Tinix.Button.Secondary}" Padding="0" FontSize="13" FontWeight="Bold" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Image Display Box (~360x360 px) -->
                    <Border Background="#0F172A" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="6" HorizontalAlignment="Center" Margin="0,0,0,10" Width="360" Height="360">
                        <Grid>
                            <Image Source="{Binding PreviewOrder.ThumbnailImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Đang nạp ảnh..." Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PreviewOrder.IsThumbnailLoading, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- File Name & Path Info -->
                    <TextBlock Text="{Binding PreviewOrder.FullThumbnailCandidatePath}" FontFamily="{StaticResource Tinix.Font.Mono}" FontSize="11" Foreground="{StaticResource Tinix.Color.Text.Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" ToolTip="{Binding PreviewOrder.FullThumbnailCandidatePath}"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding OpenPreviewContainingFolderCommand}" Content="📂 Mở Thư Mục" Style="{StaticResource Tinix.Button.Secondary}" Height="34" FontSize="12"/>
                        <Button Grid.Column="2" Command="{Binding OpenPreviewOriginalImageCommand}" Content="🖼️ Mở Ảnh Gốc" Style="{StaticResource Tinix.Button.Primary}" Height="34" FontSize="12" ToolTip="Mở ảnh gốc chất lượng cao bằng trình xem ảnh của Windows"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="LalabAutoReport.UI.Views.OrderGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thư Viện Ảnh Đơn Hàng"
        Width="940"
        Height="720"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Icon="../Resources/app.ico"
        FontFamily="{StaticResource Tinix.Font.UI}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Notice / Warning Bar -->
            <RowDefinition Height="*"/>    <!-- Gallery Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,12" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🖼️" FontSize="26" Margin="0,0,14,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtOrderCode" Text="[DH-XXXXXX]" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Tinix.Color.Text.Primary}" Margin="0,0,10,0"/>
                        <Border x:Name="badgeTotal" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTotalCount" Text="0 ảnh" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="txtOrderName" Text="Khách hàng / Tên thư mục" FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="🔄 Làm mới" Style="{StaticResource Tinix.Button.Secondary}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnRefresh_Click" ToolTip="Quét lại thư mục in để nạp danh sách ảnh mới nhất"/>
                    <Button Content="📂 Mở thư mục" Style="{StaticResource Tinix.Button.Secondary}" Height="32" Padding="12,0" Click="BtnOpenFolder_Click" ToolTip="Mở thư mục đơn hàng trong Windows Explorer"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notice / Banner -->
        <Border x:Name="bannerNotice" Grid.Row="1" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtNotice" Text="Ghi chú đơn hàng" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Gallery Content -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <StackPanel x:Name="pnlLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Đang tải danh sách ảnh in..." FontSize="14" Foreground="{StaticResource Tinix.Color.Text.Secondary}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Empty State -->
            <StackPanel x:Name="pnlEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="📷" FontSize="40" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,8"/>
                <TextBlock Text="Không có ảnh in JPG/JPEG nào trong thư mục in đã chọn của đơn này." FontSize="14" Foreground="{StaticResource Tinix.Color.Text.Secondary}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Main Scrollable Content -->
            <ScrollViewer x:Name="scrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" ScrollChanged="GalleryScroll_ScrollChanged">
                <StackPanel Margin="0,0,8,0">
                    <ItemsControl x:Name="icGroups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Group Header -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📐 " FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SpecificationName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Tinix.Color.Text.Primary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FolderDisplayName}" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                            </Border>
                                        </Grid>

                                        <!-- Group Resolution Warning if any -->
                                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding WarningMessage}" FontSize="12" Foreground="#991B1B"/>
                                        </Border>

                                        <!-- Image Grid -->
                                        <ItemsControl ItemsSource="{Binding DisplayItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="136" Height="164" Margin="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="ImageCard_Click" ToolTip="{Binding TooltipText}" Loaded="ImageCard_Loaded" Unloaded="ImageCard_Unloaded">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="120"/>
                                                                <RowDefinition Height="40"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Image Area -->
                                                            <Grid Grid.Row="0" Background="#F1F5F9">
                                                                <!-- Loading Spinner / Placeholder -->
                                                                <TextBlock Text="⏳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                                                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                                                                <!-- Error Icon -->
                                                                <TextBlock Text="⚠️ Lỗi" FontSize="11" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"/>
                                                                <!-- Actual Image -->
                                                                <Image Source="{Binding ImageSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <!-- File Label Area -->
                                                            <Border Grid.Row="1" Background="#FFFFFF" Padding="6,4" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                                                                <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Tinix.Font.Mono}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Load More Button -->
                    <Button x:Name="btnLoadMore" Content="⬇ Tải thêm 24 ảnh" Style="{StaticResource Tinix.Button.Secondary}" Height="36" Margin="0,8,0,16" HorizontalAlignment="Center" Padding="24,0" Click="BtnLoadMore_Click" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStatus" Grid.Column="0" Text="Đã tải 0 / 0 ảnh" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Secondary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Đóng (Esc)" Style="{StaticResource Tinix.Button.Primary}" Height="32" Padding="20,0" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="LalabAutoReport.UI.Views.ShippingLabelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem Trước Tem Đóng Gói / Giao Hàng"
        Width="680"
        Height="540"
        MinWidth="520"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Icon="../Resources/app.ico"
        FontFamily="{StaticResource Tinix.Font.UI}"
        Background="{StaticResource Tinix.Color.Bg.Body}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Preview Image Container -->
            <RowDefinition Height="Auto"/> <!-- Printer Info & Settings -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🏷️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitle" Text="Tem đóng gói bưu kiện" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Tinix.Color.Text.Primary}"/>
                    <TextBlock x:Name="txtSubtitle" Text="Mã đơn / Khách hàng" FontSize="12" Foreground="{StaticResource Tinix.Color.Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview Image Container (75x100mm thermal ratio) -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Md}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <!-- Loading indicator -->
                <StackPanel x:Name="pnlLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="⏳ Đang tạo hình ảnh xem trước..." FontSize="13" Foreground="{StaticResource Tinix.Color.Text.Secondary}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Label Image -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                        <Border.Effect>
                            <DropShadowEffect Color="#64748B" BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <Image x:Name="imgPreview" MaxWidth="600" MaxHeight="380" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Printer Info & Settings -->
        <Border Grid.Row="2" Background="{StaticResource Tinix.Color.Bg.Surface}" BorderBrush="{StaticResource Tinix.Color.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Tinix.Radius.Sm}" Padding="12,8" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="txtPrinterName" Text="🖨️ Máy in: Đang tải cấu hình..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Tinix.Color.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                <CheckBox x:Name="chkAutoDeliver" Content="Tự động đánh dấu ĐÃ GIAO sau khi in tem" IsChecked="True" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource Tinix.Color.Text.Secondary}"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtStatus" Grid.Column="0" Text="" FontSize="11" Foreground="{StaticResource Tinix.Color.Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đóng" Width="90" Height="36" Margin="0,0,10,0" Style="{StaticResource Tinix.Button.Secondary}" Click="Close_Click" IsCancel="True"/>
                <Button x:Name="btnPrint" Content="🖨️ In Tem" Width="130" Height="36" Style="{StaticResource Tinix.Button.Primary}" Click="Print_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

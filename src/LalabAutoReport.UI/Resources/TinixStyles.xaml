                            <Setter TargetName="border" Property="Background" Value="{StaticResource Tinix.Color.Border.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Tinix.Color.Border}"/>
                        </Trigger>

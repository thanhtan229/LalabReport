    <!-- BUTTON: PAYMENT TOGGLE (Checkbox-style toggle button for payment status) -->
    <Style x:Key="Tinix.Button.PaymentToggle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#059669"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ToolTip" Value="Đánh dấu ĐÃ THANH TOÁN"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Tinix.Radius.Md}"
                            SnapsToDevicePixels="True">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Checkmark icon: Shown ONLY when IsPaid is True (Checked state) -->
                            <Path x:Name="checkIcon" Width="15" Height="15" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- When IsPaid == True: Show checkmark inside the checkbox -->
                        <DataTrigger Binding="{Binding IsPaid}" Value="True">
                            <Setter TargetName="checkIcon" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 1. Default (IsPaid == False): Unchecked empty checkbox -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0FDF4"/>
                <Setter Property="BorderBrush" Value="#10B981"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#DCFCE7"/>
                <Setter Property="BorderBrush" Value="#059669"/>
            </Trigger>

            <!-- 2. When IsPaid == True: Checked checkbox with green border and green checkmark -->
            <DataTrigger Binding="{Binding IsPaid}" Value="True">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#10B981"/>
                <Setter Property="Foreground" Value="#059669"/>
                <Setter Property="ToolTip" Value="Đánh dấu CHƯA THANH TOÁN (Hoàn tác)"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPaid}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#ECFDF5"/>
                <Setter Property="BorderBrush" Value="#059669"/>
                <Setter Property="Foreground" Value="#047857"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPaid}" Value="True"/>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#D1FAE5"/>
                <Setter Property="BorderBrush" Value="#047857"/>
                <Setter Property="Foreground" Value="#047857"/>
            </MultiDataTrigger>

            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#F3F4F6"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>


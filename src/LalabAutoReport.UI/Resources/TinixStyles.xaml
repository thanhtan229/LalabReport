    <!-- RADIO BUTTON: SIDEBAR NAVIGATION TAB -->
    <Style x:Key="Tinix.Sidebar.NavTab" TargetType="RadioButton">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="navBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Tinix.Radius.Md}"
                            Padding="8,0,12,0"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Left active indicator bar -->
                                <ColumnDefinition Width="Auto"/> <!-- Icon container -->
                                <ColumnDefinition Width="*"/>    <!-- Title text -->
                            </Grid.ColumnDefinitions>

                            <!-- 1. Left active accent bar (Tinix Orange) -->
                            <Border x:Name="activeIndicator"
                                    Grid.Column="0"
                                    Width="4"
                                    Height="22"
                                    Background="{StaticResource Tinix.Color.Primary}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,8,0"
                                    Opacity="0"/>

                            <!-- 2. Icon Badge / Container -->
                            <Border x:Name="iconBox"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="{StaticResource Tinix.Radius.Sm}"
                                    Background="Transparent"
                                    Margin="0,0,10,0">
                                <TextBlock x:Name="iconText"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- 3. Title Text -->
                            <TextBlock x:Name="labelText"
                                       Grid.Column="2"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource Tinix.Font.UI}"
                                       FontSize="{StaticResource Tinix.FontSize.Small}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Tinix.Color.Text.Secondary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover (Inactive) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource Tinix.Color.Border.Subtle}"/>
                            <Setter TargetName="labelText" Property="Foreground" Value="{StaticResource Tinix.Color.Text.Primary}"/>
                            <Setter TargetName="iconBox" Property="Background" Value="#E5E1D8"/>
                        </MultiTrigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource Tinix.Color.Border}"/>
                        </Trigger>

                        <!-- Checked / Active Tab (Elevated White Card with Orange Accent) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource Tinix.Color.Bg.Surface}"/>
                            <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Border}"/>
                            <Setter TargetName="activeIndicator" Property="Opacity" Value="1"/>
                            <Setter TargetName="iconBox" Property="Background" Value="{StaticResource Tinix.Color.Primary.Subtle}"/>
                            <Setter TargetName="labelText" Property="Foreground" Value="{StaticResource Tinix.Color.Text.Primary}"/>
                            <Setter TargetName="labelText" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="navBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#706860" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.10"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RADIO BUTTON: FILTER PILL -->
    <Style x:Key="Tinix.FilterPill" TargetType="RadioButton">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="{StaticResource Tinix.Color.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tinix.Color.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource Tinix.Font.UI}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="pillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Tinix.Radius.Full}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="pillBorder" Property="Background" Value="{StaticResource Tinix.Color.Border.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Text.Primary}"/>
                        </MultiTrigger>

                        <!-- Checked / Active Pill -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="{StaticResource Tinix.Color.Primary}"/>
                            <Setter TargetName="pillBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="pillBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource TinixColorPrimaryRaw}" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TEXTBOX: STANDARD -->
    <Style x:Key="Tinix.TextBox.Standard" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Tinix.Color.Bg.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tinix.Color.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Tinix.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Tinix.FontSize.Small}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Tinix.Radius.Md}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Tinix.Color.Text.Secondary}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

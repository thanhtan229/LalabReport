    <!-- ==========================================
         TAB CONTROL & TAB ITEM (TINIX SLEEK TABS)
         ========================================== -->
    <Style x:Key="Tinix.TabItem" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource Tinix.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Tinix.FontSize.Small}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Text.Secondary}"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tabBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,3"
                            CornerRadius="6,6,0,0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="headerContent"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource Tinix.Color.Border.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Text.Primary}"/>
                        </MultiTrigger>

                        <!-- Selected / Active Tab -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource Tinix.Color.Primary}"/>
                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource Tinix.Color.Primary.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Tinix.Color.Primary}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tinix.TabControl" TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Header Row with subtle bottom divider line -->
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource Tinix.Color.Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Margin="0,0,0,14"
                                SnapsToDevicePixels="True">
                            <TabPanel IsItemsHost="True"
                                      VerticalAlignment="Bottom"/>
                        </Border>

                        <!-- Tab Content Body -->
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl" BasedOn="{StaticResource Tinix.TabControl}"/>
    <Style TargetType="TabItem" BasedOn="{StaticResource Tinix.TabItem}"/>

</ResourceDictionary>

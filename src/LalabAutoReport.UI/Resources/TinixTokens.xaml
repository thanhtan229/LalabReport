<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==========================================
         TINIX DESIGN TOKENS
         Shared UX/UI Contract for Lalab Auto Report
         ========================================== -->

    <!-- BRAND COLORS -->
    <Color x:Key="TinixColorPrimaryRaw">#FF4800</Color>
    <Color x:Key="TinixColorPrimaryHoverRaw">#C93700</Color>
    <Color x:Key="TinixColorPrimaryActiveRaw">#9F2800</Color>
    <Color x:Key="TinixColorPrimarySubtleRaw">#1AFF4800</Color>
    <Color x:Key="TinixColorPrimaryFocusRaw">#26FF4800</Color>

    <SolidColorBrush x:Key="Tinix.Color.Primary" Color="{StaticResource TinixColorPrimaryRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Primary.Hover" Color="{StaticResource TinixColorPrimaryHoverRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Primary.Active" Color="{StaticResource TinixColorPrimaryActiveRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Primary.Subtle" Color="{StaticResource TinixColorPrimarySubtleRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Primary.Focus" Color="{StaticResource TinixColorPrimaryFocusRaw}"/>

    <!-- BRAND ACCENT / DATE POD TOKENS -->
    <Color x:Key="TinixColorDatePodBgRaw">#FFF6F2</Color>
    <Color x:Key="TinixColorDatePodBorderRaw">#FFCCA8</Color>
    <SolidColorBrush x:Key="Tinix.Color.DatePod.Bg" Color="{StaticResource TinixColorDatePodBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.DatePod.Border" Color="{StaticResource TinixColorDatePodBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.DatePod.Text" Color="{StaticResource TinixColorPrimaryHoverRaw}"/>

    <!-- NEUTRAL SURFACES & TEXT -->
    <Color x:Key="TinixColorBgBodyRaw">#F8F5EE</Color>
    <Color x:Key="TinixColorBgSurfaceRaw">#FFFFFF</Color>
    <Color x:Key="TinixColorBgSubtleRaw">#FCFCFA</Color>
    <Color x:Key="TinixColorBgSidebarRaw">#F1EFEA</Color>
    <Color x:Key="TinixColorBorderRaw">#CFCCCB</Color>
    <Color x:Key="TinixColorBorderSubtleRaw">#EAE8E4</Color>
    <Color x:Key="TinixColorTextPrimaryRaw">#1F1F1F</Color>
    <Color x:Key="TinixColorTextSecondaryRaw">#5F6368</Color>
    <Color x:Key="TinixColorTextMutedRaw">#9B9897</Color>

    <SolidColorBrush x:Key="Tinix.Color.Bg.Body" Color="{StaticResource TinixColorBgBodyRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Bg.App" Color="{StaticResource TinixColorBgBodyRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Bg.Surface" Color="{StaticResource TinixColorBgSurfaceRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Bg.Subtle" Color="{StaticResource TinixColorBgSubtleRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Bg.Sidebar" Color="{StaticResource TinixColorBgSidebarRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Border" Color="{StaticResource TinixColorBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Border.Subtle" Color="{StaticResource TinixColorBorderSubtleRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Text.Primary" Color="{StaticResource TinixColorTextPrimaryRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Text.Secondary" Color="{StaticResource TinixColorTextSecondaryRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Text.Muted" Color="{StaticResource TinixColorTextMutedRaw}"/>

    <!-- SEMANTIC STATUS COLORS -->
    <!-- Success: Teal -->
    <Color x:Key="TinixColorSuccessRaw">#124548</Color>
    <Color x:Key="TinixColorSuccessBgRaw">#DFF2E7</Color>
    <Color x:Key="TinixColorSuccessBorderRaw">#B8E4CC</Color>
    <SolidColorBrush x:Key="Tinix.Color.Success" Color="{StaticResource TinixColorSuccessRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Success.Bg" Color="{StaticResource TinixColorSuccessBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Success.Border" Color="{StaticResource TinixColorSuccessBorderRaw}"/>

    <!-- Warning: Amber -->
    <Color x:Key="TinixColorWarningRaw">#8A5700</Color>
    <Color x:Key="TinixColorWarningBgRaw">#FFF0C9</Color>
    <Color x:Key="TinixColorWarningBorderRaw">#E9C66E</Color>
    <Color x:Key="TinixColorWarningHoverBgRaw">#FFE49E</Color>
    <Color x:Key="TinixColorWarningActiveBgRaw">#FDD87A</Color>
    <SolidColorBrush x:Key="Tinix.Color.Warning" Color="{StaticResource TinixColorWarningRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Warning.Bg" Color="{StaticResource TinixColorWarningBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Warning.Border" Color="{StaticResource TinixColorWarningBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Warning.Hover" Color="{StaticResource TinixColorWarningHoverBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Warning.Active" Color="{StaticResource TinixColorWarningActiveBgRaw}"/>

    <!-- Danger: Red -->
    <Color x:Key="TinixColorDangerRaw">#D9002B</Color>
    <Color x:Key="TinixColorDangerBgRaw">#F7DFDC</Color>
    <Color x:Key="TinixColorDangerBorderRaw">#E8A4A1</Color>
    <SolidColorBrush x:Key="Tinix.Color.Danger" Color="{StaticResource TinixColorDangerRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Danger.Bg" Color="{StaticResource TinixColorDangerBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Danger.Border" Color="{StaticResource TinixColorDangerBorderRaw}"/>

    <!-- Info: Navy -->
    <Color x:Key="TinixColorInfoRaw">#15295A</Color>
    <Color x:Key="TinixColorInfoBgRaw">#CAEBFF</Color>
    <Color x:Key="TinixColorInfoBorderRaw">#A6DCFF</Color>
    <Color x:Key="TinixColorInfoHoverBgRaw">#B8E2FC</Color>
    <Color x:Key="TinixColorInfoActiveBgRaw">#96D4FA</Color>
    <SolidColorBrush x:Key="Tinix.Color.Info" Color="{StaticResource TinixColorInfoRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Info.Bg" Color="{StaticResource TinixColorInfoBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Info.Border" Color="{StaticResource TinixColorInfoBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Info.Hover" Color="{StaticResource TinixColorInfoHoverBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Info.Active" Color="{StaticResource TinixColorInfoActiveBgRaw}"/>

    <!-- KPI CARD TOKENS -->
    <!-- Card 1: Revenue (Peach / Warm Orange - Brand) -->
    <Color x:Key="TinixCardRevenueBgRaw">#FFF6F2</Color>
    <Color x:Key="TinixCardRevenueBorderRaw">#FFCCA8</Color>
    <Color x:Key="TinixCardRevenueTitleRaw">#C93700</Color>
    <Color x:Key="TinixCardRevenueValueRaw">#9F2800</Color>
    <SolidColorBrush x:Key="Tinix.Color.Card.Revenue.Bg" Color="{StaticResource TinixCardRevenueBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Revenue.Border" Color="{StaticResource TinixCardRevenueBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Revenue.Title" Color="{StaticResource TinixCardRevenueTitleRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Revenue.Value" Color="{StaticResource TinixCardRevenueValueRaw}"/>

    <!-- Card 2: Print Volume / Quantity (Sky Blue) -->
    <Color x:Key="TinixCardPrintBgRaw">#EFF6FF</Color>
    <Color x:Key="TinixCardPrintBorderRaw">#BFDBFE</Color>
    <Color x:Key="TinixCardPrintTitleRaw">#1D4ED8</Color>
    <Color x:Key="TinixCardPrintValueRaw">#1E3A8A</Color>
    <SolidColorBrush x:Key="Tinix.Color.Card.Print.Bg" Color="{StaticResource TinixCardPrintBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Print.Border" Color="{StaticResource TinixCardPrintBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Print.Title" Color="{StaticResource TinixCardPrintTitleRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Print.Value" Color="{StaticResource TinixCardPrintValueRaw}"/>

    <!-- Card 3: Orders (Purple / Lavender) -->
    <Color x:Key="TinixCardOrderBgRaw">#F5F3FF</Color>
    <Color x:Key="TinixCardOrderBorderRaw">#DDD6FE</Color>
    <Color x:Key="TinixCardOrderTitleRaw">#6D28D9</Color>
    <Color x:Key="TinixCardOrderValueRaw">#5B21B6</Color>
    <SolidColorBrush x:Key="Tinix.Color.Card.Order.Bg" Color="{StaticResource TinixCardOrderBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Order.Border" Color="{StaticResource TinixCardOrderBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Order.Title" Color="{StaticResource TinixCardOrderTitleRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Order.Value" Color="{StaticResource TinixCardOrderValueRaw}"/>

    <!-- Card 4: Customers / CRM (Emerald / Teal Mint) -->
    <Color x:Key="TinixCardCustomerBgRaw">#ECFDF5</Color>
    <Color x:Key="TinixCardCustomerBorderRaw">#A7F3D0</Color>
    <Color x:Key="TinixCardCustomerTitleRaw">#047857</Color>
    <Color x:Key="TinixCardCustomerValueRaw">#065F46</Color>
    <SolidColorBrush x:Key="Tinix.Color.Card.Customer.Bg" Color="{StaticResource TinixCardCustomerBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Customer.Border" Color="{StaticResource TinixCardCustomerBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Customer.Title" Color="{StaticResource TinixCardCustomerTitleRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Customer.Value" Color="{StaticResource TinixCardCustomerValueRaw}"/>

    <!-- Card 5: Review / Pending / Debt (Amber / Warm Gold) -->
    <Color x:Key="TinixCardReviewBgRaw">#FFFBEB</Color>
    <Color x:Key="TinixCardReviewBorderRaw">#FDE68A</Color>
    <Color x:Key="TinixCardReviewTitleRaw">#B45309</Color>
    <Color x:Key="TinixCardReviewValueRaw">#92400E</Color>
    <SolidColorBrush x:Key="Tinix.Color.Card.Review.Bg" Color="{StaticResource TinixCardReviewBgRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Review.Border" Color="{StaticResource TinixCardReviewBorderRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Review.Title" Color="{StaticResource TinixCardReviewTitleRaw}"/>
    <SolidColorBrush x:Key="Tinix.Color.Card.Review.Value" Color="{StaticResource TinixCardReviewValueRaw}"/>


    <!-- TYPOGRAPHY -->
    <FontFamily x:Key="Tinix.Font.Display">Georgia, Times New Roman, Serif</FontFamily>
    <FontFamily x:Key="Tinix.Font.UI">Segoe UI, Helvetica Neue, Sans-Serif</FontFamily>
    <FontFamily x:Key="Tinix.Font.Mono">Consolas, Cascadia Code, Courier New, Monospace</FontFamily>

    <sys:Double x:Key="Tinix.FontSize.Display">28</sys:Double>
    <sys:Double x:Key="Tinix.FontSize.Section">20</sys:Double>
    <sys:Double x:Key="Tinix.FontSize.Subsection">16</sys:Double>
    <sys:Double x:Key="Tinix.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="Tinix.FontSize.Small">13</sys:Double>
    <sys:Double x:Key="Tinix.FontSize.Caption">11</sys:Double>

    <!-- CORNER RADIUS -->
    <CornerRadius x:Key="Tinix.Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Tinix.Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Tinix.Radius.Lg">16</CornerRadius>
    <CornerRadius x:Key="Tinix.Radius.Full">9999</CornerRadius>

</ResourceDictionary>
